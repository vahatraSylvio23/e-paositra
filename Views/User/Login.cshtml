@model ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Connexion";
}

<div class="flex min-h-screen items-center justify-center bg-slate-100 px-4">
    <div class="w-full max-w-md">
        <div class="mb-6 text-center">
            <h1 class="text-2xl font-semibold text-slate-900">e_paositra</h1>
            <p class="mt-1 text-sm text-slate-500">Connectez-vous à votre compte</p>
        </div>

        <div class="rounded-sm border border-slate-200 bg-white p-8 shadow-lg">
            <form asp-action="Login" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-slate-700">Email</label>
                    <input asp-for="Email" type="email" autocomplete="email"
                           class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
                    <span asp-validation-for="Email" class="mt-1 block text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Password" class="block text-sm font-medium text-slate-700">
                        Mot de passe
                    </label>
                    <div class="mt-1 flex items-center gap-2">
                        <input asp-for="Password"
                            id="Password"
                            type="password"
                            autocomplete="current-password"
                            class="flex-1 rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
                        <button type="button"id="togglePassword"class="shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-600 hover:bg-slate-100">Afficher</button>
                    </div>
                    <span asp-validation-for="Password" class="mt-1 block text-xs text-red-600"></span>
                </div>

                <button type="submit"
                        class="mt-2 w-full rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800">
                    Se connecter
                </button>
            </form>
        </div>

        <p class="mt-4 text-center text-sm text-slate-500">
            Pas encore de compte ?
            <a asp-action="Register" class="font-semibold text-slate-900 hover:underline">Inscrivez-vous</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    const passwordInput = document.getElementById("Password");
    const toggleButton = document.getElementById("togglePassword");

    toggleButton.addEventListener("click", function () {

        const isHidden = passwordInput.type === "password";

        passwordInput.type = isHidden ? "text" : "password";

        toggleButton.textContent = isHidden ? "Cacher" : "Afficher";
    });
</script>
@model ViewModel.RegisterViewModel

@{
    ViewData["Title"] = "Inscription";
}

<div class="mx-auto max-w-2xl rounded-3xl bg-white p-8 shadow-xl ring-1 ring-slate-200 sm:p-10">
    <h2 class="text-2xl font-semibold text-slate-900">Inscription</h2>
    <p class="mt-2 text-sm text-slate-500">Créez un compte pour accéder à votre espace.</p>

    <form asp-action="Register" method="post" class="mt-8 space-y-6">
        <div asp-validation-summary="All" class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="FirstName" class="block text-sm font-medium text-slate-700">Prénom</label>
                <input asp-for="FirstName" class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500" />
                <span asp-validation-for="FirstName" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="LastName" class="block text-sm font-medium text-slate-700">Nom</label>
                <input asp-for="LastName" class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500" />
                <span asp-validation-for="LastName" class="mt-1 block text-sm text-red-600"></span>
            </div>
        </div>

        <div>
            <label asp-for="Email" class="block text-sm font-medium text-slate-700">Email</label>
            <input asp-for="Email" class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500" />
            <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-slate-700">Mot de passe</label>
            <input asp-for="Password" type="password" class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500" />
            <span asp-validation-for="Password" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="Role" class="block text-sm font-medium text-slate-700">Rôle</label>
                <input asp-for="Role" class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500" />
                <span asp-validation-for="Role" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="ServiceId" class="block text-sm font-medium text-slate-700">Service ID</label>
                <input asp-for="ServiceId" type="number" class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500" />
                <span asp-validation-for="ServiceId" class="mt-1 block text-sm text-red-600"></span>
            </div>
        </div>

        <button type="submit" class="w-full rounded-xl bg-emerald-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">S'inscrire</button>
    </form>

    <p class="mt-6 text-center text-sm text-slate-600">Déjà un compte ? <a class="font-semibold text-indigo-600 hover:text-indigo-700" asp-action="Login">Connectez-vous</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model ViewModel.VehicleViewModel

@{
    ViewData["Title"] = "Supprimer le véhicule";
    var isAdmin = Context.Session.GetString("UserRole") == "Admin";
    var vehicleId = ViewBag.VehicleId as int? ?? 0;
}

@if (!isAdmin)
{
    <div class="container mx-auto max-w-lg px-4 py-16 text-center">
        <div class="rounded-3xl border border-slate-200 bg-white p-10 shadow-sm">
            <svg class="mx-auto mb-4 h-12 w-12 text-slate-300" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93-2.67-1.14-5-4.43-5-7.93V7.18L12 5z"/>
            </svg>
            <h1 class="text-xl font-semibold text-slate-900 mb-2">Accès restreint</h1>
            <p class="text-sm text-slate-500 mb-6">Vous n'avez pas les droits pour accéder à cette page.</p>
            <a asp-action="Index" class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-50">
                Retour
            </a>
        </div>
    </div>
    return;
}

<div class="container mx-auto max-w-2xl px-4 py-12">
    <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
        <div class="mb-6">
            <p class="text-xs uppercase tracking-widest text-red-500 font-semibold mb-1">Zone de danger</p>
            <h1 class="text-3xl font-semibold text-slate-900">Supprimer le véhicule</h1>
            <p class="mt-2 text-sm text-slate-500">Cette action est irréversible.</p>
        </div>

        <div class="my-6 rounded-2xl bg-slate-50 p-6 border border-slate-100 space-y-3 text-sm text-slate-700">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Informations du véhicule</h2>
            <div class="grid grid-cols-3 gap-2 border-b border-slate-200/60 pb-2">
                <span class="font-medium text-slate-500">Immatriculation :</span>
                <span class="col-span-2 font-semibold text-slate-900">@Model.VehicleLicensePlate</span>
            </div>
            <div class="grid grid-cols-3 gap-2 border-b border-slate-200/60 pb-2">
                <span class="font-medium text-slate-500">Conducteur :</span>
                <span class="col-span-2">@Model.VehicleDriver</span>
            </div>
            <div class="grid grid-cols-3 gap-2 border-b border-slate-200/60 pb-2">
                <span class="font-medium text-slate-500">État :</span>
                <span class="col-span-2">@Model.VehicleState</span>
            </div>
            <div class="grid grid-cols-3 gap-2 border-b border-slate-200/60 pb-2">
                <span class="font-medium text-slate-500">Départ :</span>
                <span class="col-span-2">@Model.VehicleLeft.ToString("dd MMM yyyy HH:mm")</span>
            </div>
            <div class="grid grid-cols-3 gap-2">
                <span class="font-medium text-slate-500">Arrivée :</span>
                <span class="col-span-2">@Model.VehicleArrived.ToString("dd MMM yyyy HH:mm")</span>
            </div>
        </div>

        @if (Model.MailSent != null && Model.MailSent.Any())
        {
            <div class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 p-4">
                <p class="text-sm font-semibold text-amber-800 mb-2">
                    ⚠ Ce véhicule transporte @Model.MailSent.Count() courrier(s). Ils seront dissociés mais non supprimés.
                </p>
                <ul class="space-y-1 text-xs text-amber-700 list-disc list-inside">
                    @foreach (var mail in Model.MailSent)
                    {
                        <li>@mail.Reference — @mail.Sender → @mail.Recipient</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Delete" method="post" class="flex flex-col sm:flex-row gap-3 sm:justify-end mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@vehicleId" />
            <a asp-action="Index"
               class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 order-2 sm:order-1">
                Annuler
            </a>
            <button type="submit"
                    class="inline-flex items-center justify-center rounded-full bg-red-600 px-6 py-3 text-sm font-semibold text-white hover:bg-red-700 order-1 sm:order-2 shadow-sm transition-colors">
                Supprimer définitivement
            </button>
        </form>
    </div>
</div>

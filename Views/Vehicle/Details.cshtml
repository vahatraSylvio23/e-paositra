@model ViewModel.VehicleViewModel

@{
    ViewData["Title"] = "Détails du véhicule";
    var isAdmin = Context.Session.GetString("UserRole") == "Admin";
    var vehicleId = ViewBag.VehicleId as int? ?? 0;
}

<div class="container mx-auto px-4 py-10">
    <div class="grid gap-6 lg:grid-cols-[2fr_320px]">

        <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <div class="mb-6 flex items-center justify-between">
                <div>
                    <p class="text-sm uppercase tracking-[0.2em] text-slate-400">Véhicule</p>
                    <h1 class="text-3xl font-semibold text-slate-900">@Model.VehicleLicensePlate</h1>
                </div>
                @{
                    var stateClass = Model.VehicleState == "En route"
                        ? "bg-sky-100 text-sky-800"
                        : Model.VehicleState == "Disponible"
                            ? "bg-emerald-100 text-emerald-800"
                            : "bg-amber-100 text-amber-800";
                }
                <span class="inline-flex rounded-full px-3 py-1 text-sm font-semibold @stateClass">
                    @Model.VehicleState
                </span>
            </div>

            <div class="grid gap-4 sm:grid-cols-2 text-sm text-slate-700 mb-8">
                <div class="rounded-2xl bg-slate-50 p-4 border border-slate-100">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Conducteur</p>
                    <p class="font-semibold text-slate-900">@Model.VehicleDriver</p>
                </div>


            <h2 class="text-lg font-semibold text-slate-900 mb-4">Courriers transportés</h2>
            @if (Model.MailSent == null || !Model.MailSent.Any())
            {
                <div class="rounded-2xl bg-slate-50 p-8 text-center text-sm text-slate-400 border border-slate-100">
                    Aucun courrier associé à ce véhicule.
                </div>
            }
            else
            {
                <div class="divide-y divide-slate-100 rounded-2xl border border-slate-200 overflow-hidden">
                    @foreach (var mail in Model.MailSent)
                    {
                        var statusClass = mail.Status == "Livré"
                            ? "bg-emerald-100 text-emerald-800"
                            : mail.Status == "Envoyé"
                                ? "bg-sky-100 text-sky-800"
                                : "bg-amber-100 text-amber-800";

                        <a asp-controller="Mail" asp-action="Details" asp-route-id="@mail.Id"
                           class="flex items-center justify-between bg-white px-4 py-3 hover:bg-slate-50 transition">
                            <div>
                                <p class="text-sm font-semibold text-slate-900">@mail.Reference</p>
                                <p class="text-xs text-slate-500">De : @mail.Sender → @mail.Recipient</p>
                            </div>
                            <div class="flex flex-col items-end gap-1">
                                <span class="text-xs text-slate-400">@mail.DateSent.ToString("dd MMM")</span>
                                <span class="inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold @statusClass">
                                    @(mail.Status ?? "En attente")
                                </span>
                            </div>
                        </a>
                    }
                </div>
            }

            <div class="mt-8 gap-3">
                <a asp-action="Index"
                   class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-50">
                    Retour
                </a>
                @if (isAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@vehicleId"
                       class="inline-flex items-center justify-center rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold text-white hover:bg-slate-800">
                        Modifier
                    </a>
                    <a asp-action="Delete" asp-route-id="@vehicleId"
                       class="inline-flex items-center justify-center rounded-full bg-red-600 px-6 py-3 text-sm font-semibold text-white hover:bg-red-500">
                        Supprimer
                    </a>
                }
            </div>
        </section>

        <aside class="space-y-4">
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-sm font-semibold text-slate-700 mb-4">Résumé</h2>
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-slate-500">Total courriers</span>
                        <span class="font-bold text-slate-900">@(Model.MailSent?.Count() ?? 0)</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">En attente</span>
                        <span class="font-bold text-amber-700">@(Model.MailSent?.Count(m => m.Status == "En attente") ?? 0)</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">En transit</span>
                        <span class="font-bold text-sky-700">@(Model.MailSent?.Count(m => m.Status == "Envoyé") ?? 0)</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Livrés</span>
                        <span class="font-bold text-emerald-700">@(Model.MailSent?.Count(m => m.Status == "Livré") ?? 0)</span>
                    </div>
                </div>
            </div>
        </aside>

    </div>
</div>

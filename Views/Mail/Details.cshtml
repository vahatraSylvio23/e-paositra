@model e_paositra.Models.Mail

@{
    ViewData["Title"] = "Détails du courrier";
    var currentStatus = ViewBag.CurrentStatus as string ?? "En attente";
}

<div class="container mx-auto px-4 py-10">
    <div class="grid gap-6 lg:grid-cols-[2fr_320px]">
        <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <div class="mb-6 flex flex-col gap-2">
                <p class="text-sm uppercase tracking-[0.2em] text-slate-500">Statut actuel</p>
                <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold @(currentStatus == "Livré" ? "bg-emerald-100 text-emerald-700" : currentStatus == "Envoyé" ? "bg-blue-100 text-blue-700" : "bg-amber-100 text-amber-800")">@currentStatus</span>
            </div>

            <h1 class="text-3xl font-semibold text-slate-900">@Model.Reference</h1>
            <div class="mt-4 space-y-3 text-sm text-slate-600">
                <div><strong>De :</strong> @Model.Sender</div>
                <div><strong>Code Postal :</strong> @Model.PostalCode</div>
                <div><strong>Adresse d'envoi :</strong> @Model.Address</div>
                <div><strong>Envoyé le :</strong> @Model.DateSent.ToString("dd MMM yyyy HH:mm")</div>
                <div><strong>Prévu/Livré le :</strong> @Model.DateReceived.ToString("dd MMM yyyy HH:mm")</div>
            </div>

            <div class="mt-8 rounded-3xl bg-slate-50 p-6">
                <h2 class="text-lg font-semibold text-slate-900">Message</h2>
                <p class="mt-4 whitespace-pre-line text-slate-700">@Model.Observation</p>
            </div>

            <div class="mt-8 flex flex-wrap gap-3">
                <a asp-action="Delete" asp-route-id="@Model.Id" class="inline-flex items-center justify-center rounded-full bg-red-600 px-6 py-3 text-sm font-semibold text-white hover:bg-red-500">Supprimer</a>
                <a asp-action="Dashboard" class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-50">Retour</a>
            </div>
        </section>

        <aside class="space-y-6">
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-lg font-semibold text-slate-900">Historique</h2>
                <ul class="mt-4 space-y-3 text-sm text-slate-700">
                    @foreach (var entry in (IEnumerable<e_paositra.Models.History>)ViewBag.History)
                    {
                        <li class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                            <div class="font-semibold text-slate-900">@entry.Action</div>
                            <div class="mt-1 text-sm text-slate-600">@entry.Comment</div>
                            <div class="mt-2 text-xs uppercase tracking-[0.15em] text-slate-500">@entry.ActionDate.ToString("dd/MM/yyyy HH:mm")</div>
                        </li>
                    }
                </ul>
            </div>
        </aside>
    </div>
</div>
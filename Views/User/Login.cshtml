@model ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Connexion";
}

<div class="mx-auto max-w-md rounded-3xl bg-white p-8 shadow-xl ring-1 ring-slate-200 sm:p-10">
    <h2 class="text-2xl font-semibold text-slate-900">Connexion</h2>
    <p class="mt-2 text-sm text-slate-500">Connectez-vous à votre compte pour continuer.</p>

    <form asp-action="Login" method="post" class="mt-8 space-y-6">
        <div asp-validation-summary="All" class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>

        <div class="space-y-4">
            <div>
                <label asp-for="Email" class="block text-sm font-medium text-slate-700">Email</label>
                <input asp-for="Email" class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500" />
                <span asp-validation-for="Email" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-slate-700">Mot de passe</label>
                <input asp-for="Password" type="password" class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500" />
                <span asp-validation-for="Password" class="mt-1 block text-sm text-red-600"></span>
            </div>
        </div>

        <button type="submit" class="w-full rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">Se connecter</button>
    </form>

    <p class="mt-6 text-center text-sm text-slate-600">Pas encore de compte ? <a class="font-semibold text-indigo-600 hover:text-indigo-700" asp-action="Register">Inscrivez-vous</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

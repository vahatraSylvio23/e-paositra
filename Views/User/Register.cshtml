@model ViewModel.RegisterViewModel

@{
    ViewData["Title"] = "Inscription";
}

<div class="flex min-h-screen items-center justify-center bg-slate-100 px-4 py-10">
    <div class="w-full max-w-lg">

        <!-- En-tête -->
        <div class="mb-6 text-center">
            <h1 class="text-2xl font-semibold text-slate-900">e_paositra</h1>
            <p class="mt-1 text-sm text-slate-500">Créez votre compte</p>
        </div>

        <!-- Carte -->
        <div class="rounded-lg border border-slate-200 bg-white p-8 shadow-sm">

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700"></div>
            }

            <form asp-action="Register" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <!-- Prénom / Nom -->
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label asp-for="FirstName" class="block text-sm font-medium text-slate-700">Prénom</label>
                        <input asp-for="FirstName" autocomplete="given-name"
                               class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
                        <span asp-validation-for="FirstName" class="mt-1 block text-xs text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="LastName" class="block text-sm font-medium text-slate-700">Nom</label>
                        <input asp-for="LastName" autocomplete="family-name"
                               class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
                        <span asp-validation-for="LastName" class="mt-1 block text-xs text-red-600"></span>
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-slate-700">Email</label>
                    <input asp-for="Email" type="email" autocomplete="email"
                           class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
                    <span asp-validation-for="Email" class="mt-1 block text-xs text-red-600"></span>
                </div>

                <!-- Mot de passe -->
                <div>
                    <label asp-for="Password" class="block text-sm font-medium text-slate-700">Mot de passe</label>
                    <input asp-for="Password" type="password" autocomplete="new-password"
                           class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
                    <span asp-validation-for="Password" class="mt-1 block text-xs text-red-600"></span>
                </div>

                <!-- Téléphone -->
                <div>
                    <label asp-for="PhoneNumber" class="block text-sm font-medium text-slate-700">Téléphone</label>
                    <input asp-for="PhoneNumber" type="tel" autocomplete="tel"
                           class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
                    <span asp-validation-for="PhoneNumber" class="mt-1 block text-xs text-red-600"></span>
                </div>

                <!-- Rôle -->
                @* <div>
                    <label asp-for="Role" class="block text-sm font-medium text-slate-700">Rôle</label>
                    <input asp-for="Role"
                           class="mt-1 block w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
                    <span asp-validation-for="Role" class="mt-1 block text-xs text-red-600"></span>
                </div> *@

                <button type="submit"
                        class="mt-2 w-full rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800">
                    S'inscrire
                </button>
            </form>
        </div>

        <!-- Lien connexion -->
        <p class="mt-4 text-center text-sm text-slate-500">
            Déjà un compte ?
            <a asp-action="Login" class="font-semibold text-slate-900 hover:underline">Connectez-vous</a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
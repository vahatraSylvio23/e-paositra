@model IEnumerable<e_paositra.Models.Vehicle>

@{
    ViewData["Title"] = "Véhicules";
    var isAdmin = Context.Session.GetString("UserRole") == "Admin";
}

<div class="min-h-screen bg-slate-100 text-slate-900">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">

        <div class="mb-6 flex items-center justify-between rounded-lg bg-white p-4 shadow-sm">
            <div>
                <p class="text-sm text-slate-500">Gestion du parc</p>
                <h1 class="text-2xl font-semibold text-slate-900">Véhicules</h1>
            </div>
            @if (isAdmin)
            {
                <div class="flex items-center gap-2">
                    <a asp-controller="Mail" asp-action="Dashboard"
                    class="inline-flex mr-8 rounded-lg bg-black-900 px-4 py-2 text-sm text-black font-semibold border hover:bg-gray-800 hover:text-white">
                        Retour
                    </a>

                    <a asp-action="Create"
                    class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                        </svg>
                        Ajouter un véhicule
                    </a>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="rounded-lg bg-white p-16 text-center shadow-sm">
                <svg class="mx-auto mb-3 h-12 w-12 text-slate-300" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.85 7h10.29l1.08 3.11H5.77L6.85 7zM19 17H5v-5h14v5z"/>
                    <circle cx="7.5" cy="14.5" r="1.5"/><circle cx="16.5" cy="14.5" r="1.5"/>
                </svg>
                <p class="text-sm text-slate-400">Aucun véhicule enregistré pour le moment.</p>
                @if (isAdmin)
                {
                    <a asp-action="Create" class="mt-4 inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                        Ajouter un véhicule
                    </a>
                }
            </div>
        }
        else
        {
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var v in Model)
                {
                    var stateClass = v.State == "En route"
                        ? "bg-sky-100 text-sky-800"
                        : v.State == "Disponible"
                            ? "bg-emerald-100 text-emerald-800"
                            : "bg-amber-100 text-amber-800";

                    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm flex flex-col gap-4">
                        <div class="flex items-start justify-between">
                            <div class="flex items-center gap-3">
                                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100">
                                    <svg class="h-5 w-5 text-slate-600" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.85 7h10.29l1.08 3.11H5.77L6.85 7zM19 17H5v-5h14v5z"/>
                                        <circle cx="7.5" cy="14.5" r="1.5"/><circle cx="16.5" cy="14.5" r="1.5"/>
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-base font-bold tracking-wide text-slate-900">@v.LicensePlate</p>
                                    <p class="text-xs text-slate-500">@(v.Driver ?? "Conducteur non assigné")</p>
                                </div>
                            </div>
                            <span class="inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold @stateClass">
                                @(v.State ?? "N/A")
                            </span>
                        </div>

                        <div class="space-y-1 text-xs text-slate-600 border-t border-slate-100 pt-3">

                        </div>

                        <div class="flex items-center gap-2 pt-1">
                            <a asp-action="Details" asp-route-id="@v.Id"
                               class="flex-1 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-center text-xs font-semibold text-slate-700 hover:bg-slate-100">
                                Détails
                            </a>
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@v.Id"
                                   class="flex-1 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-center text-xs font-semibold text-slate-700 hover:bg-slate-100">
                                    Modifier
                                </a>
                                <a asp-action="Delete" asp-route-id="@v.Id"
                                   class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-center text-xs font-semibold text-red-600 hover:bg-red-100">
                                    Supprimer
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

@model ViewModel.DashboardViewModel

@{
    ViewData["Title"] = "Tableau de bord";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Bonjour" : hour < 18 ? "Bon après-midi" : "Bonsoir";
    var isAdmin = Context.Session.GetString("UserRole") == "Admin";
}

<div class="min-h-screen bg-slate-100 text-slate-900">
    <div class="mx-auto flex min-h-screen max-w-7xl">

        <aside class="flex w-64 flex-col justify-between border-r border-slate-200 bg-white p-4">
            <div>
                <div class="mb-4 border-b border-slate-200 pb-4">
                    <h1 class="text-lg font-semibold text-slate-900">Courrier</h1>
                    <p class="mt-1 text-sm text-slate-500">@Model.CurrentUserEmail</p>
                </div>

                <a asp-controller="Mail" asp-action="Create"
                   class="mb-4 block rounded-lg bg-slate-900 px-3 py-2 text-center text-sm font-semibold text-white hover:bg-slate-800">
                    Envoyer un courrier
                </a>

                <nav class="space-y-1 text-sm">
                    <p class="px-3 pt-2 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Navigation</p>

                    <a asp-controller="Mail" asp-action="Dashboard"
                       class="flex items-center gap-2 rounded-lg bg-slate-100 px-3 py-2 font-semibold text-slate-900">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
                        </svg>
                        Tableau de bord
                    </a>

                    <p class="px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Par statut</p>
                    <a asp-controller="Mail" asp-action="Index" asp-route-status="pending"
                       class="flex items-center justify-between rounded-lg px-3 py-2 text-slate-900 hover:bg-slate-100">
                        <span>En attente</span>
                        <span class="rounded-full px-2 py-0.5 text-xs font-semibold text-amber-800">@Model.PendingCount</span>
                    </a>
                    <a asp-controller="Mail" asp-action="Index" asp-route-status="sent"
                       class="flex items-center justify-between rounded-lg px-3 py-2 text-slate-900 hover:bg-slate-100">
                        <span>Envoyé</span>
                        <span class="rounded-full px-2 py-0.5 text-xs font-semibold text-sky-800">@Model.SentCount</span>
                    </a>
                    <a asp-controller="Mail" asp-action="Index" asp-route-status="delivered"
                       class="flex items-center justify-between rounded-lg px-3 py-2 text-slate-900 hover:bg-slate-100">
                        <span>Livré</span>
                        <span class="rounded-full px-2 py-0.5 text-xs font-semibold text-emerald-800">@Model.DeliveredCount</span>
                    </a>

                    @if (isAdmin)
                    {
                        <p class="px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Administration</p>
                        <a asp-controller="Vehicle" asp-action="Index"
                           class="flex items-center gap-2 rounded-lg px-3 py-2 text-slate-900 hover:bg-slate-100">
                            <svg class="h-4 w-4 text-slate-500" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.85 7h10.29l1.08 3.11H5.77L6.85 7zM19 17H5v-5h14v5z"/>
                                <circle cx="7.5" cy="14.5" r="1.5"/><circle cx="16.5" cy="14.5" r="1.5"/>
                            </svg>
                            Véhicules
                        </a>
                    }
                </nav>
            </div>

            <div class="border-t border-slate-200 pt-4">

            </div>
        </aside>

        <main class="flex-1 p-6">

            <div class="mb-6 flex items-center justify-between rounded-lg bg-white p-4 shadow-sm">
                <div>
                    <h2 class="text-2xl font-semibold text-slate-900">@Model.FirstName @Model.LastName</h2>
                </div>
                <div class="flex items-center gap-3">
                    @if (isAdmin)
                    {
                        <a asp-controller="Vehicle" asp-action="Index"
                           class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                            Gérer les véhicules
                        </a>
                    }
                    <a asp-controller="Mail" asp-action="Create"
                       class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                        Nouveau courrier
                    </a>
                </div>
            </div>

            <div class="mb-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
                <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Total</p>
                    <p class="mt-2 text-3xl font-bold text-slate-900">@(Model.InboxCount + Model.OutboxCount)</p>
                    <p class="mt-1 text-xs text-slate-500">courriers au total</p>
                </div>
                <div class="rounded-sm border border-amber-200 bg-amber-10 p-4 shadow-sm">
                    <p class="text-xs font-semibold uppercase tracking-wide text-amber-600">En attente</p>
                    <p class="mt-2 text-3xl font-bold text-amber-700">@Model.PendingCount</p>
                    <p class="mt-1 text-xs text-amber-500">à traiter</p>
                </div>
                <div class="rounded-lg border border-sky-200 bg-sky-10 p-4 shadow-sm">
                    <p class="text-xs font-semibold uppercase tracking-wide text-sky-600">Envoyé</p>
                    <p class="mt-2 text-3xl font-bold text-sky-700">@Model.SentCount</p>
                    <p class="mt-1 text-xs text-sky-500">en cours d'acheminement</p>
                </div>
                <div class="rounded-lg border border-emerald-200 bg-emerald-10 p-4 shadow-sm">
                    <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Livrés</p>
                    <p class="mt-2 text-3xl font-bold text-emerald-700">@Model.DeliveredCount</p>
                    <p class="mt-1 text-xs text-emerald-500">avec succès</p>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
                <div class="lg:col-span-2">
                    <div class="rounded-lg border border-slate-200 bg-white shadow-sm">
                        <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
                            <h3 class="text-sm font-semibold text-slate-700">Activité récente</h3>
                            <a asp-controller="Mail" asp-action="Index" asp-route-folder="outbox"
                               class="text-xs font-medium text-slate-500 hover:text-slate-900 hover:underline">Voir tout</a>
                        </div>

                        <div class="divide-y divide-slate-50">
                            @if (!Model.RecentMails.Any())
                            {
                                <div class="px-4 py-8 text-center text-sm text-slate-400">
                                    <svg class="mx-auto mb-2 h-8 w-8 text-slate-300" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                                    </svg>
                                    Aucun courrier récent.
                                </div>
                            }
                            @foreach (var mail in Model.RecentMails)
                            {
                                var isInbox = mail.Recipient == Model.CurrentUserEmail;
                                var displayName = isInbox ? mail.Sender : mail.Recipient;
                                var initials = displayName?.Length > 0 ? displayName[0].ToString().ToUpper() : "?";
                                var avatarColors = new[] { "#4285f4","#0f9d58","#db4437","#f4b400","#7e57c2","#00acc1","#e67c73","#33b679" };
                                var colorIndex = Math.Abs(displayName?.GetHashCode() ?? 0) % avatarColors.Length;
                                var avatarColor = avatarColors[colorIndex];
                                var statusClass = mail.StatusLabel == "Livré"
                                    ? "bg-emerald-100 text-emerald-800"
                                    : mail.StatusLabel == "Envoyé"
                                        ? "bg-sky-100 text-sky-800"
                                        : "bg-amber-100 text-amber-800";

                                <a asp-controller="Mail" asp-action="Details" asp-route-id="@mail.Id"
                                   class="flex items-center justify-between px-4 py-3 hover:bg-slate-50 transition">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
                                             style="background: @avatarColor">@initials</div>
                                        <div class="min-w-0">
                                            <p class="truncate text-sm font-semibold text-slate-900">@mail.Reference</p>
                                            <p class="truncate text-xs text-slate-500">
                                                @(isInbox ? $"De : {mail.Sender}" : $"À : {mail.Recipient}")
                                            </p>
                                        </div>
                                    </div>
                                    <div class="ml-4 flex flex-shrink-0 flex-col items-end gap-1">
                                        <span class="text-xs text-slate-400">@mail.DateSent.ToString("dd MMM")</span>
                                        <span class="inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold @statusClass">@mail.StatusLabel</span>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>